---
/**
 * Decorative geospatial "situational awareness" panel for the home hero.
 * Pure SVG + CSS animation, no runtime dependencies. Hidden from AT.
 */
const points = [
  { x: 210, y: 150, d: 0 },
  { x: 268, y: 236, d: 0.6 },
  { x: 160, y: 262, d: 1.3 },
  { x: 300, y: 172, d: 2.1 },
  { x: 232, y: 300, d: 2.8 },
  { x: 128, y: 190, d: 3.4 },
];
---

<div class="radar reticle" aria-hidden="true">
  <div class="radar__hud radar__hud--tl mono">
    <span>LAT 38.92 N</span>
    <span>LON 77.23 W</span>
  </div>
  <div class="radar__hud radar__hud--tr mono">
    <span>IBN<sup>®</sup> · ACTIVE</span>
  </div>

  <svg class="radar__svg" viewBox="0 0 440 440" fill="none">
    <defs>
      <radialGradient id="sweep" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(220 220) rotate(0) scale(200)">
        <stop offset="0" stop-color="#c6ea3d" stop-opacity="0.45" />
        <stop offset="1" stop-color="#c6ea3d" stop-opacity="0" />
      </radialGradient>
      <clipPath id="disc"><circle cx="220" cy="220" r="200" /></clipPath>
    </defs>

    <!-- contour lines -->
    <g class="radar__contours" stroke="rgba(134,198,255,0.22)" stroke-width="1" clip-path="url(#disc)">
      <path d="M20 300c40-60 90-40 130-80s60-110 120-100 90 80 150 60" />
      <path d="M20 330c50-70 100-45 140-90s70-120 130-105 100 90 150 70" />
      <path d="M20 360c60-80 110-50 150-100s80-130 140-110 110 100 150 80" />
      <path d="M20 240c40-30 90-20 130-60s60-90 120-90 90 60 150 50" />
      <path d="M20 200c40-20 90-10 130-40s60-70 120-70 90 40 150 30" />
    </g>

    <!-- grid -->
    <g stroke="rgba(255,255,255,0.08)" clip-path="url(#disc)">
      <path d="M20 220h400M220 20v400M60 60l320 320M380 60 60 380" />
    </g>

    <!-- rings -->
    <g stroke="rgba(255,255,255,0.14)">
      <circle cx="220" cy="220" r="200" />
      <circle cx="220" cy="220" r="150" stroke-dasharray="3 6" />
      <circle cx="220" cy="220" r="100" />
      <circle cx="220" cy="220" r="50" stroke-dasharray="2 5" />
    </g>

    <!-- degree ticks -->
    <g class="radar__ticks" stroke="rgba(255,255,255,0.28)" stroke-width="1">
      {Array.from({ length: 36 }).map((_, i) => (
        <line x1="220" y1="20" x2="220" y2={i % 3 === 0 ? '30' : '25'} transform={`rotate(${i * 10} 220 220)`} />
      ))}
    </g>

    <!-- sweep -->
    <g class="radar__sweep">
      <path d="M220 220 L220 20 A200 200 0 0 1 361 79 Z" fill="url(#sweep)" />
      <line x1="220" y1="220" x2="220" y2="20" stroke="#c6ea3d" stroke-width="1.5" stroke-linecap="round" />
    </g>

    <!-- plotted contacts -->
    {points.map((p) => (
      <g class="radar__pt" style={`--d:${p.d}s`}>
        <circle cx={p.x} cy={p.y} r="3" fill="#c6ea3d" />
        <circle cx={p.x} cy={p.y} r="3" fill="none" stroke="#c6ea3d" class="radar__ping" />
      </g>
    ))}

    <!-- home marker -->
    <g>
      <circle cx="220" cy="220" r="5" fill="#0a0d13" stroke="#e9edf2" stroke-width="1.5" />
      <circle cx="220" cy="220" r="1.5" fill="#e9edf2" />
    </g>
  </svg>

  <div class="radar__hud radar__hud--bl mono">
    <span>EST. 2019</span>
    <span>MCLEAN, VA</span>
  </div>
  <div class="radar__hud radar__hud--br mono">
    <span class="radar__live"><i></i> LIVE</span>
  </div>
</div>

<style>
  .radar {
    position: relative;
    aspect-ratio: 1;
    width: 100%;
    max-width: 520px;
    margin-inline: auto;
    background:
      radial-gradient(circle at 50% 50%, rgba(198, 234, 61, 0.06), transparent 55%),
      var(--ink-950);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 8%;
  }

  .radar__svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .radar__hud {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    color: var(--muted);
    line-height: 1.4;
  }

  .radar__hud sup {
    font-size: 0.6em;
  }

  .radar__hud--tl { top: 0.9rem; left: 1rem; }
  .radar__hud--tr { top: 0.9rem; right: 1rem; text-align: right; color: var(--signal); }
  .radar__hud--bl { bottom: 0.9rem; left: 1rem; }
  .radar__hud--br { bottom: 0.9rem; right: 1rem; text-align: right; }

  .radar__live {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-2);
  }

  .radar__live i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 0 rgba(198, 234, 61, 0.6);
    animation: pulse 2s infinite;
  }

  .radar__sweep {
    transform-origin: 220px 220px;
    animation: spin 7s linear infinite;
  }

  .radar__ticks {
    transform-origin: 220px 220px;
    animation: spin 240s linear infinite reverse;
  }

  .radar__ping {
    transform-origin: center;
    transform-box: fill-box;
    animation: ping 3.6s var(--ease-out) infinite;
    animation-delay: var(--d);
    opacity: 0;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @keyframes ping {
    0% { transform: scale(1); opacity: 0.9; }
    70% { transform: scale(5); opacity: 0; }
    100% { transform: scale(5); opacity: 0; }
  }

  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(198, 234, 61, 0.6); }
    70% { box-shadow: 0 0 0 8px rgba(198, 234, 61, 0); }
    100% { box-shadow: 0 0 0 0 rgba(198, 234, 61, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .radar__sweep,
    .radar__ticks,
    .radar__ping,
    .radar__live i {
      animation: none;
    }

    .radar__ping {
      opacity: 0;
    }
  }
</style>
