---
import '@fontsource/sora/600.css';
import '@fontsource/sora/700.css';
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/700.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Pluribus builds secure, AI-powered technologies for government, public safety, and critical infrastructure — mission-ready situational awareness and connected operations.',
} = Astro.props;

const navLinks = [
  { href: '/technologies/', label: 'Technologies' },
  { href: '/capabilities/', label: 'Capabilities' },
  { href: '/environments/', label: 'Environments' },
  { href: '/insights/', label: 'Insights' },
  { href: '/company/', label: 'Company' },
];

const footerNav = [...navLinks, { href: '/contact/', label: 'Contact Us' }];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href.replace(/\/$/, ''));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#060b14" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/pluribus-wordmark.png" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-header__brand" href="/">
          <img src="/images/pluribus-wordmark.png" alt="Pluribus — home" width="151" height="38" />
        </a>
        <button
          class="site-header__toggle"
          aria-expanded="false"
          aria-controls="site-nav"
        >
          <span class="visually-hidden">Menu</span>
          <span class="site-header__bar" aria-hidden="true"></span>
          <span class="site-header__bar" aria-hidden="true"></span>
          <span class="site-header__bar" aria-hidden="true"></span>
        </button>
        <nav id="site-nav" class="site-nav" aria-label="Main">
          <ul>
            {
              navLinks.map((link) => (
                <li>
                  <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                    {link.label}
                  </a>
                </li>
              ))
            }
            <li class="site-nav__cta">
              <a class="btn btn--solid" href="/contact/">Contact Us</a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <hr class="hairline" />
      <div class="container site-footer__grid">
        <div class="site-footer__brand">
          <img src="/images/pluribus-wordmark.png" alt="" width="151" height="38" />
          <p>
            Mission-driven technologies for government, public safety, and critical
            infrastructure.
          </p>
          <p class="site-footer__motto" aria-label="Mission ready. AI powered. Connected intelligence.">
            Mission Ready.<br />AI Powered.<br />Connected Intelligence.
          </p>
        </div>
        <nav aria-label="Footer">
          <h2 class="site-footer__head">Navigation</h2>
          <ul class="site-footer__links">
            {
              footerNav.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div>
          <h2 class="site-footer__head">Contact</h2>
          <address class="site-footer__contact">
            <p><a href="mailto:info@pluribusdata.com">info@pluribusdata.com</a></p>
            <p><a href="tel:+15713804740">571-380-4740</a></p>
            <!-- Live site says 1640 Boro Place; the Figma footer says 640 — using the
                 live site's address until the team confirms which is correct. -->
            <p>1640 Boro Place, 4th Floor<br />McLean, VA 22102</p>
            <p>
              <a href="https://www.linkedin.com/company/pluribus-inc" rel="noopener">LinkedIn</a>
            </p>
          </address>
        </div>
        <div>
          <h2 class="site-footer__head">Ready to see Pluribus in action?</h2>
          <a class="btn btn--ghost" href="/contact/">Request a Demo</a>
        </div>
      </div>
      <div class="container">
        <hr class="hairline" />
      </div>
      <div class="container site-footer__legal">
        <p>
          © {new Date().getFullYear()} Pluribus Inc. All Rights Reserved.<br />
          Identity-Based Navigation®, IBN®, OurWays™, ANJEL® and Guardian ANJEL® are marks of
          Pluribus Inc.
        </p>
        <ul class="site-footer__legal-links">
          <li><a href="/privacy/">Privacy Policy</a></li>
          <li><a href="/terms/">Terms</a></li>
          <li><a href="/accessibility/">Accessibility</a></li>
        </ul>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector('.site-header__toggle');
      const nav = document.getElementById('site-nav');
      toggle?.addEventListener('click', () => {
        const open = nav?.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', String(Boolean(open)));
      });
      // Close the menu with Escape (focus returns to the toggle)
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && nav?.classList.contains('is-open')) {
          nav.classList.remove('is-open');
          toggle?.setAttribute('aria-expanded', 'false');
          (toggle as HTMLElement | null)?.focus();
        }
      });
    </script>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: rgba(6, 11, 20, 0.94);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--outline-variant);
      }

      .site-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        padding-block: 1rem;
      }

      .site-header__brand img {
        width: 151px;
        height: auto;
      }

      .site-nav ul {
        display: flex;
        align-items: center;
        gap: 2.25rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .site-nav a:not(.btn) {
        color: var(--heading);
        font-weight: 400;
        font-size: var(--size-body);
      }

      .site-nav a:not(.btn):hover {
        color: var(--brand-light);
        text-decoration: none;
      }

      .site-nav a:not(.btn)[aria-current='page'] {
        color: var(--accent-readable);
        font-weight: 700;
      }

      .site-nav__cta .btn {
        padding: 0.7rem 1.4rem;
      }

      .site-header__toggle {
        display: none;
        flex-direction: column;
        gap: 5px;
        background: none;
        border: 0;
        padding: 0.6rem;
        cursor: pointer;
      }

      .site-header__bar {
        width: 24px;
        height: 2px;
        background: var(--heading);
      }

      @media (max-width: 900px) {
        .site-header__toggle {
          display: flex;
        }

        .site-nav {
          display: none;
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          background: rgba(6, 11, 20, 0.98);
          border-bottom: 1px solid var(--outline-variant);
        }

        .site-nav.is-open {
          display: block;
        }

        .site-nav ul {
          flex-direction: column;
          align-items: stretch;
          gap: 0;
          padding: 0.5rem 0 1.25rem;
        }

        .site-nav a:not(.btn) {
          display: block;
          padding: 0.85rem clamp(1.25rem, 4vw, 2.5rem);
        }

        .site-nav__cta {
          padding: 0.85rem clamp(1.25rem, 4vw, 2.5rem);
        }
      }

      .site-footer {
        background: var(--bg);
      }

      .site-footer__grid {
        display: grid;
        grid-template-columns: 1.4fr 1fr 1fr 1fr;
        gap: 2.5rem;
        padding-block: 3.5rem;
      }

      @media (max-width: 980px) {
        .site-footer__grid {
          grid-template-columns: 1fr 1fr;
        }
      }

      @media (max-width: 560px) {
        .site-footer__grid {
          grid-template-columns: 1fr;
        }
      }

      .site-footer__brand img {
        margin-bottom: 1.25rem;
      }

      .site-footer__brand p {
        color: var(--text);
        max-width: 38ch;
      }

      .site-footer__motto {
        font-weight: 700;
        font-size: var(--size-overline);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--accent-readable);
      }

      .site-footer__head {
        font-family: var(--font-body);
        font-size: var(--size-body-lg);
        font-weight: 400;
        color: var(--heading);
        margin-bottom: 1rem;
      }

      .site-footer__links {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .site-footer__links li {
        margin-bottom: 0.55rem;
      }

      .site-footer__links a,
      .site-footer__contact a {
        color: var(--text);
      }

      .site-footer__links a:hover,
      .site-footer__contact a:hover {
        color: var(--brand-light);
      }

      .site-footer__contact {
        font-style: normal;
      }

      .site-footer__contact p {
        margin-bottom: 0.7rem;
      }

      .site-footer__legal {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 0.75rem;
        padding-block: 1.5rem;
        color: var(--text);
        font-size: var(--size-caption);
      }

      .site-footer__legal p {
        margin: 0;
      }

      .site-footer__legal-links {
        display: flex;
        gap: 1.5rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .site-footer__legal-links a {
        color: var(--text);
      }

      .site-footer__legal-links a:hover {
        color: var(--brand-light);
      }
    </style>
  </body>
</html>
