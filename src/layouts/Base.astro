---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Pluribus Inc. is a big data, geosocial & geospatial analytics company pioneering Identity-Based Navigation®.',
} = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/technology/', label: 'Our Technology' },
  { href: '/about/', label: 'About' },
  { href: '/team/', label: 'Team' },
  { href: '/contact/', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href.replace(/\/$/, ''));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/logo-pluribus.png" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-header__brand" href="/">
          <img src="/images/logo-pluribus.png" alt="Pluribus Inc." width="160" height="41" />
        </a>
        <button class="site-header__toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Toggle menu">
          <span></span><span></span><span></span>
        </button>
        <nav id="site-nav" class="site-nav">
          <ul>
            {
              navLinks.map((link) => (
                <li>
                  <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__grid">
        <div>
          <img src="/images/logo-pluribus.png" alt="Pluribus Inc." width="180" height="46" />
          <p class="site-footer__tagline">Providing a personalized, safer world for each person!</p>
        </div>
        <div>
          <h4>Connect With Us</h4>
          <p>
            <a href="mailto:info@pluribusdata.com">info@pluribusdata.com</a><br />
            <a href="tel:+15713804740">Tel: 571-380-4740</a>
          </p>
          <p>
            1640 Boro Place, 4th Floor<br />
            McLean, VA 22102
          </p>
        </div>
        <div>
          <h4>Follow Us</h4>
          <ul class="site-footer__social">
            <li><a href="https://www.facebook.com/driveourways" rel="noopener">Facebook</a></li>
            <li><a href="https://www.twitter.com/driveourways" rel="noopener">Twitter</a></li>
            <li><a href="https://www.instagram.com/driveourways/" rel="noopener">Instagram</a></li>
          </ul>
        </div>
      </div>
      <div class="container site-footer__legal">
        <p>© {new Date().getFullYear()} Pluribus Inc. All rights reserved.</p>
        <p>Identity-Based Navigation®, IBN®, OurWays™, ANJEL® and Guardian ANJEL® are marks of Pluribus Inc.</p>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector('.site-header__toggle');
      const nav = document.getElementById('site-nav');
      toggle?.addEventListener('click', () => {
        const open = nav?.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', String(Boolean(open)));
      });
    </script>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: rgba(0, 0, 0, 0.92);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--color-border);
      }

      .site-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-block: 0.9rem;
      }

      .site-header__brand img {
        width: 160px;
        height: auto;
      }

      .site-nav ul {
        display: flex;
        gap: 1.75rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .site-nav a {
        color: var(--color-text);
        font-weight: 600;
        font-size: var(--size-step--1);
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .site-nav a:hover {
        color: var(--color-accent);
        text-decoration: none;
      }

      .site-nav a[aria-current='page'] {
        color: var(--color-accent);
      }

      .site-header__toggle {
        display: none;
        flex-direction: column;
        gap: 5px;
        background: none;
        border: 0;
        padding: 0.5rem;
        cursor: pointer;
      }

      .site-header__toggle span {
        width: 24px;
        height: 2px;
        background: var(--color-text);
      }

      @media (max-width: 760px) {
        .site-header__toggle {
          display: flex;
        }

        .site-nav {
          display: none;
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          background: rgba(0, 0, 0, 0.97);
          border-bottom: 1px solid var(--color-border);
        }

        .site-nav.is-open {
          display: block;
        }

        .site-nav ul {
          flex-direction: column;
          gap: 0;
          padding: 0.5rem 0 1rem;
        }

        .site-nav a {
          display: block;
          padding: 0.8rem clamp(1.25rem, 4vw, 2.5rem);
        }
      }

      .site-footer {
        background: var(--color-black);
        border-top: 1px solid var(--color-border);
        padding-block: 3.5rem 2rem;
        margin-top: var(--space-section);
      }

      .site-footer__grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 2.5rem;
      }

      .site-footer__grid h4 {
        font-size: var(--size-step--1);
        text-transform: uppercase;
        letter-spacing: 0.18em;
        color: var(--color-accent);
      }

      .site-footer__tagline {
        color: var(--color-muted);
        margin-top: 1rem;
        max-width: 30ch;
      }

      .site-footer__social {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .site-footer__social li {
        margin-bottom: 0.4rem;
      }

      .site-footer__social a,
      .site-footer__grid a {
        color: var(--color-text);
      }

      .site-footer__social a:hover,
      .site-footer__grid a:hover {
        color: var(--color-accent);
      }

      .site-footer__legal {
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--color-border);
        color: var(--color-muted);
        font-size: var(--size-step--1);
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.5rem;
      }

      .site-footer__legal p {
        margin: 0;
      }
    </style>
  </body>
</html>
