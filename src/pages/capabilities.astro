---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';

// Section names from the Figma "Capabilities" page outline; every
// capability title/description pair is verbatim from the design board.
const sections = [
  {
    id: 'operational-awareness',
    name: 'Operational Awareness',
    items: [
      { title: 'Real-Time Awareness', text: 'See everything. As it happens.' },
      { title: 'Situational Awareness', text: 'Complete visibility across incidents and teams.' },
      { title: 'Live Geolocation', text: 'Real-time tracking of personnel and assets.' },
    ],
  },
  {
    id: 'connected-infrastructure',
    name: 'Connected Infrastructure',
    items: [
      { title: 'Unified Information', text: 'One platform. One view. Complete clarity.' },
      { title: 'Connected Intelligence', text: 'Unify data, systems, and teams for complete clarity.' },
      { title: 'Seamlessly Integrated', text: 'Connects with your systems and workflows.' },
    ],
  },
  {
    id: 'real-time-coordination',
    name: 'Real-Time Coordination',
    items: [
      { title: 'Secure Communication', text: 'Encrypted messaging and group coordination.' },
      { title: 'Live Streaming', text: 'Share live video and images in real time.' },
      { title: 'Coordinated Action', text: 'The right information to the right people—fast.' },
    ],
  },
  {
    id: 'ai-analytics',
    name: 'AI & Analytics',
    items: [
      { title: 'Actionable Insights', text: 'AI-powered analytics reveal what matters most.' },
      { title: 'Faster Decisions', text: 'Actionable insights. When every second counts.' },
      { title: 'Faster Response', text: 'Empower teams to act with speed and confidence.' },
    ],
  },
  {
    id: 'scalable-systems',
    name: 'Scalable Systems',
    items: [
      { title: 'Built for Mission', text: 'Engineered for reliability when it matters most.' },
      { title: 'Secure & Reliable', text: 'Enterprise-grade security and uptime you can trust.' },
      { title: 'Always Evolving', text: 'Continuously updated to stay ahead of emerging threats.' },
    ],
  },
];
---

<Base
  title="Capabilities | Pluribus Inc"
  description="Operational awareness, connected infrastructure, real-time coordination, AI & analytics, and scalable systems — the capabilities behind Pluribus technologies."
>
  <section class="section section--deep">
    <div class="container">
      <span class="eyebrow">Capabilities</span>
      <h1>Continuous Intelligence. Mission Impact.</h1>
      <p class="lead">
        Supporting organizations with AI-powered technologies for safer, faster, and more informed
        decisions.
      </p>
    </div>
  </section>

  {
    sections.map((section, i) => (
      <section class:list={['section', { 'section--variant': i % 2 === 1 }]} id={section.id}>
        <div class="container">
          <h2>{section.name}</h2>
          <ul class="cap-grid">
            {section.items.map((item) => (
              <li class="card">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <section class="section section--light" id="highlights">
    <div class="container">
      <SectionHeading eyebrow="Capability Highlights" title="Real-Time Data. Connected Intelligence." />
      <ul class="highlights">
        <li><strong>Real-Time Data</strong> — Ingest from any source, anytime, anywhere.</li>
        <li><strong>Connected Intelligence</strong> — Unify data, systems, and teams for complete clarity.</li>
        <li><strong>Actionable Insights</strong> — AI-powered analytics reveal what matters most.</li>
        <li><strong>Faster Response</strong> — Empower teams to act with speed and confidence.</li>
      </ul>
    </div>
  </section>

  <section class="section cta-band">
    <div class="container">
      <hr class="hairline" />
      <div class="cta-band__body">
        <h2>Ready to see Pluribus in action?</h2>
        <div class="cta-band__actions">
          <a class="btn btn--solid" href="/technologies/">Explore Technologies</a>
          <a class="btn btn--ghost" href="/contact/">Request a Demo</a>
        </div>
      </div>
      <hr class="hairline" />
    </div>
  </section>
</Base>

<style>
  .cap-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1.25rem;
  }

  .cap-grid p {
    margin: 0;
    color: var(--text);
  }

  .highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1.25rem;
  }

  .highlights li {
    background: #fff;
    border: 1px solid var(--light-outline);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }

  .cta-band__body {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: clamp(2rem, 4vw, 3rem);
  }

  .cta-band__body h2 {
    margin: 0;
  }

  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>
