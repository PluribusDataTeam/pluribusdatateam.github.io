---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const members = await getCollection('team');
  return members.map((member) => ({
    params: { slug: member.id },
    props: { member },
  }));
}

const { member } = Astro.props;
const { Content } = await render(member);
---

<Base title={`${member.data.name} | Pluribus Inc`} description={`${member.data.name}, ${member.data.title} at Pluribus Inc.`}>
  <section class="section">
    <div class="container bio">
      <div class="bio__sidebar">
        <Image
          src={member.data.headshot}
          alt={`Portrait of ${member.data.name}`}
          width="640"
          class="bio__photo"
        />
        <a class="bio__back" href="/team/">← Back to Team</a>
      </div>
      <div>
        <span class="eyebrow">{member.data.title}</span>
        <h1>{member.data.name}</h1>
        <div class="prose">
          <Content />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .bio {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 820px) {
    .bio {
      grid-template-columns: 1fr;
    }

    .bio__sidebar {
      max-width: 320px;
    }
  }

  .bio__photo {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
  }

  .bio__back {
    display: inline-block;
    margin-top: 1.25rem;
    font-weight: 600;
  }

  .bio h1 {
    font-size: var(--size-step-3);
  }
</style>
