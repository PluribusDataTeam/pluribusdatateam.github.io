---
import Base from '../layouts/Base.astro';
---

<Base
  title="Privacy Policy | Pluribus Inc"
  description="Privacy policy for pluribusdata.com."
>
  <section class="section section--deep">
    <div class="container">
      <span class="eyebrow">Legal</span>
      <h1>Privacy Policy</h1>
      <p class="lead">Draft — pending review by counsel before publication.</p>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>What this site collects</h2>
      <p>
        This website is a static informational site. It does not set cookies, does not use
        analytics or advertising trackers, and does not include a form that transmits data to us.
        Fonts and all other assets are served from this site directly — no third-party services
        receive your visit data from us.
      </p>

      <h2>When you contact us</h2>
      <p>
        If you email or call us, we receive the information you choose to share (such as your name
        and contact details) and use it only to respond to your inquiry. We do not sell personal
        information.
      </p>

      <h2>Hosting</h2>
      <p>
        Like nearly all websites, our hosting provider may keep standard server logs (IP address,
        pages requested, timestamps) for security and operational purposes.
      </p>

      <h2>Questions</h2>
      <p>
        Contact <a href="mailto:info@pluribusdata.com">info@pluribusdata.com</a> with any privacy
        questions.
      </p>

      <p><em>Last updated July 20, 2026. This draft must be reviewed by legal counsel before the site launches publicly.</em></p>
    </div>
  </section>
</Base>
