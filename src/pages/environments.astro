---
import Base from '../layouts/Base.astro';

// Titles/subtitles are verbatim from the Figma environment cards; the
// remaining environments come from the Figma "Environments" page outline.
// Body copy intentionally omitted until the team provides it.
const environments = [
  {
    id: 'government',
    name: 'Government',
    sub: 'Mission Operations',
    image: '/images/env-government.png',
    alt: 'United States Capitol dome behind an American flag',
  },
  {
    id: 'public-safety',
    name: 'Public Safety',
    sub: 'Emergency Response',
    image: '/images/step-5-respond-resolve.png',
    alt: 'Police, fire, and EMS units at an active incident',
  },
  {
    id: 'enterprise',
    name: 'Enterprise',
    sub: 'Connected Operations',
    image: '/images/hero-night-ops.png',
    alt: 'Operations leader reviewing a live dashboard over a city at night',
  },
  {
    id: 'smart-communities',
    name: 'Smart Communities',
    sub: 'Connected infrastructure and community-focused environments',
    image: '/images/step-2-share-location.png',
    alt: 'Connected community map with live location pins',
  },
  {
    id: 'healthcare',
    name: 'Healthcare & Senior Care',
    sub: 'Monitoring and communication technologies for care environments',
    image: '/images/step-1-detect-report.png',
    alt: 'Caregiver using a mobile alert application',
  },
  {
    id: 'education',
    name: 'Education & Campus Safety',
    sub: 'Connected safety and communication for educational environments',
    image: '/images/product-guardian-anjel.png',
    alt: 'Student walking on a city street with a safety app active',
  },
  {
    id: 'critical-infrastructure',
    name: 'Critical Infrastructure',
    sub: 'Essential Services',
    image: '/images/step-3-notify-command.png',
    alt: 'Infrastructure command center with monitoring dashboards',
  },
];
---

<Base
  title="Environments | Pluribus Inc"
  description="Government, public safety, enterprise, smart communities, healthcare, education, and critical infrastructure — the environments Pluribus technologies support."
>
  <section class="section section--deep">
    <div class="container">
      <span class="eyebrow">Mission Environments</span>
      <h1>Built for the World's Most Critical Operations.</h1>
      <p class="lead">
        Supporting organizations with AI-powered technologies for safer, faster, and more informed
        decisions.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ul class="env-grid">
        {
          environments.map((env) => (
            <li class="env-card" id={env.id}>
              <img src={env.image} alt={env.alt} loading="lazy" />
              <div class="env-card__caption">
                <h2>{env.name}</h2>
                <p>{env.sub}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section cta-band">
    <div class="container">
      <hr class="hairline" />
      <div class="cta-band__body">
        <h2>Let's Build Smarter, Safer Operations.</h2>
        <a class="btn btn--solid" href="/contact/">Connect With Our Team</a>
      </div>
      <hr class="hairline" />
    </div>
  </section>
</Base>

<style>
  .env-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1.5rem;
  }

  .env-card {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--outline-variant);
    scroll-margin-top: 6rem;
  }

  .env-card img {
    width: 100%;
    height: 15rem;
    object-fit: cover;
  }

  .env-card__caption {
    padding: 1.25rem 1.5rem 1.5rem;
  }

  .env-card__caption h2 {
    font-size: var(--size-h3);
    margin-bottom: 0.25rem;
  }

  .env-card__caption p {
    margin: 0;
    color: var(--text);
  }

  .cta-band__body {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: clamp(2rem, 4vw, 3rem);
  }

  .cta-band__body h2 {
    margin: 0;
  }
</style>
