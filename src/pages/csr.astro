---
import Base from '../layouts/Base.astro';
---

<Base
  title="Corporate Social Responsibility | Pluribus Inc"
  description="Pluribus Inc.'s Corporate Social Responsibility program — including our sponsorship of the Baton Rouge Youth Coalition (BRYC)."
>
  <section class="section section--deep">
    <div class="container">
      <span class="eyebrow">Corporate Social Responsibility</span>
      <h1>Investing in People. On and Off Mission.</h1>
      <p class="lead">
        Our mission is protecting people through intelligent technology — and it doesn't stop at
        the products we build. Pluribus invests in the communities and the next generation of
        leaders who will build a safer world.
      </p>
    </div>
  </section>

  <section class="section" id="bryc">
    <div class="container">
      <span class="eyebrow">Featured Sponsorship</span>
      <h2>Baton Rouge Youth Coalition (BRYC)</h2>
      <p class="prose">
        Pluribus is a proud sponsor of the
        <a href="https://www.brycacademy.org/" rel="noopener" target="_blank">
          Baton Rouge Youth Coalition ↗
        </a>
        — an organization that prepares high-achieving, under-resourced students to enter,
        excel in, and graduate from college. Supporting BRYC's students is a direct investment in
        the engineers, analysts, and leaders of tomorrow.
      </p>
      <p class="prose">
        <!-- TODO: additional sponsorships and photos to come (per design notes, more
             sponsorship material will be provided for this page). -->
        More CSR initiatives will be featured here as the program grows.
      </p>
      <a class="btn btn--solid" href="https://www.brycacademy.org/" rel="noopener" target="_blank">
        Learn about BRYC ↗
      </a>
    </div>
  </section>
</Base>
