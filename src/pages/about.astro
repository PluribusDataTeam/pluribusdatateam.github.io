---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import SectionHead from '../components/SectionHead.astro';

const values = [
  { name: 'Truth', text: 'We present and represent The Truth in all things.' },
  { name: 'Respect', text: 'We respect each other; we respect you; we respect your life.' },
  { name: 'Understanding', text: 'We seek to understand all settings, all people, all things.' },
  { name: 'Service', text: 'We serve you; we serve humanity.' },
  { name: 'Teamwork', text: 'We work together as a team; we are honored to be on your life team.' },
];
---

<Base
  title="About | Pluribus Inc"
  description="Our mission, vision, technology and values — Pluribus Inc., a big data, geosocial & geospatial analytics company in McLean, Virginia."
>
  <section class="page-head">
    <div class="grid-bg"></div>
    <div class="container">
      <span class="eyebrow">About Pluribus</span>
      <h1>Who we are</h1>
      <p class="lead">
        Pluribus Inc. is a big data, geosocial &amp; geospatial analytics company. Founded in 2019,
        we specialize in making the complex simple, the obscure plain and the unknown known.
      </p>
      <div class="page-head__meta">
        <span>Est. 2019</span>
        <span>McLean, Virginia</span>
        <span>Big data · Geosocial · Geospatial</span>
      </div>
    </div>
  </section>

  <section class="section paper">
    <div class="container about-grid">
      <div class="about-mission reveal">
        <span class="eyebrow">Our Mission</span>
        <p class="about-mission__text" data-words>
          We were created to tell every person in the world where they are, based on who they are;
          to help every person in the world make smarter decisions about where they go and how they
          get there, based on who they are; to make the world a safer and better place for each and
          every person, based on who they are; and to lead the world in Identity-Based
          Navigation®.
        </p>
      </div>
      <div class="about-vision reveal" data-delay="2" data-tilt="4">
        <span class="eyebrow">Our Vision</span>
        <p class="about-vision__text">
          Intelligent, Identity-Based Navigation® for human- and machinekind.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container about-tech">
      <div class="about-tech__head reveal">
        <span class="eyebrow">About Pluribus</span>
        <h2>Our Technology</h2>
        <p class="section-head__aside about-tech__aside">5G · AI · Blockchain · IoT</p>
      </div>
      <p class="prose about-tech__text reveal" data-delay="2">
        Through enabling technologies such as 5G, artificial intelligence, blockchain and the
        internet of things (IoT), we believe a new epoch of human, machine and interrelated
        connectivity is on the near horizon. Foreseeing this convergence and positioning ourselves
        to be an industry leader in this new environment, we are pioneering new methodologies of
        data science, data analytics, decision science, and geosocial &amp; geospatial awareness.
        And because we believe there's no real design, only redesign, we're leveraging the history
        of these elements to (re-)apply them with new technological augmentation.
      </p>
    </div>
  </section>

  <section class="section section--tight values-section">
    <div class="container">
      <SectionHead eyebrow="About Pluribus" title="Our Values / Our Ethos" aside="Five principles" />
      <ol class="values">
        {
          values.map((value, i) => (
            <li class="values__item reveal" data-delay={String(i + 1)} data-spotlight>
              <span class="values__n mono">{String(i + 1).padStart(2, '0')}</span>
              <h3>{value.name}</h3>
              <p>{value.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container about-cta reveal">
      <div>
        <span class="eyebrow">Team Pluribus</span>
        <h2>Meet the Team!</h2>
      </div>
      <a class="btn btn--primary" href="/team/">Meet the Team <Arrow /></a>
    </div>
  </section>
</Base>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  @media (max-width: 860px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }

  .about-mission__text {
    font-family: var(--font-display);
    font-weight: 520;
    font-size: var(--fs-2);
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: pretty;
  }

  .about-vision {
    padding: clamp(1.75rem, 3vw, 2.5rem);
    border-left: 3px solid var(--paper-text);
    background: rgba(255, 255, 255, 0.5);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
  }

  .about-vision__text {
    font-family: var(--font-display);
    font-weight: 640;
    font-size: var(--fs-2);
    line-height: 1.15;
    letter-spacing: -0.025em;
    margin: 0;
  }

  .about-tech {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  @media (max-width: 860px) {
    .about-tech {
      grid-template-columns: 1fr;
    }
  }

  .about-tech__head h2 {
    margin-bottom: 0.75rem;
  }

  .about-tech__aside {
    text-align: left;
    margin: 0;
  }

  .about-tech__text {
    font-size: var(--fs-1);
    max-width: 62ch;
    margin: 0;
  }

  .values {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--ink-800);
  }

  @media (max-width: 1000px) {
    .values {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .values {
      grid-template-columns: 1fr;
    }
  }

  .values__item {
    padding: clamp(1.5rem, 2.5vw, 2rem);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-right: -1px;
    margin-bottom: -1px;
    transition: background 0.3s ease;
  }

  .values__item:hover {
    background: var(--ink-700);
  }

  .values__n {
    display: block;
    color: var(--signal);
    font-size: var(--fs--2);
    letter-spacing: 0.12em;
    margin-bottom: 2.5rem;
  }

  .values__item h3 {
    font-size: var(--fs-1);
    margin-bottom: 0.5rem;
  }

  .values__item p {
    margin: 0;
    color: var(--text-2);
    font-size: var(--fs--1);
  }

  .about-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--line);
  }

  .about-cta h2 {
    margin: 0;
    max-width: 20ch;
  }
</style>
