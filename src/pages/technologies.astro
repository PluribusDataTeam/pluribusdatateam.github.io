---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
---

<Base
  title="Technologies | Pluribus Inc"
  description="Guardian ANJEL™, ANJEL KLAXON™, and the Pluribus AI Intelligence Platform — plus the Big Data, IBN®, OurWays™ and ANJEL® Tech portfolio."
>
  <section class="section section--deep">
    <div class="container">
      <span class="eyebrow">Technologies</span>
      <h1>Intelligent Solutions. Mission Impact.</h1>
      <p class="lead">
        Purpose-built technologies that connect data, people, and operations—empowering
        organizations to detect, communicate, and respond with confidence.
      </p>
    </div>
  </section>

  <section class="section" id="guardian-anjel">
    <div class="container tech-split">
      <div>
        <span class="eyebrow">Flagship Technology</span>
        <h2>Guardian ANJEL™</h2>
        <p class="prose">
          A real-time situational awareness platform that helps improve safety, communication, and
          coordinated response during critical events.
        </p>
        <p class="prose">
          Designed for military installation security, Guardian ANJEL enhances military security
          with real-time, first-person intelligence. Turning every smartphone into a GPS-enabled,
          live-streaming, incident-reporting tool, we empower Security Forces to respond faster and
          smarter. Because when seconds matter, Guardian ANJEL delivers.
        </p>
        <p class="prose">
          Every military base in the world faces a universal challenge: when seconds matter most,
          the information needed to make critical decisions isn't always clear, timely, or
          actionable. This gap in situational awareness can jeopardize lives, missions, and the
          safety of military installations.
        </p>
        <p class="prose">
          At Guardian ANJEL, we are transforming the way Security Forces respond to threats by
          providing cutting-edge technology that delivers clarity and speed when it matters most.
        </p>
        <h3 class="tech-split__subhead">Highlights</h3>
        <ul class="feature-list">
          <li>Real-Time Awareness</li>
          <li>Secure Communication</li>
          <li>Live Location Sharing</li>
        </ul>
        <a class="btn btn--ghost" href="https://www.guardiananjel.com" rel="noopener" target="_blank">
          Visit www.guardiananjel.com for more information ↗
        </a>
      </div>
      <img
        src="/images/guardian-anjel-emblem.png"
        alt="Guardian ANJEL emblem — a winged A with a halo inside a camera lens"
        width="420"
        loading="lazy"
        class="tech-split__emblem"
      />
    </div>
  </section>

  <section class="section section--deep tagline-band">
    <div class="container">
      <p class="tagline-band__text">See Something - Say Something - <strong>STREAM Something!™</strong></p>
    </div>
  </section>

  <section class="section section--variant" id="anjel-klaxon">
    <div class="container tech-split">
      <div>
        <span class="eyebrow">Emergency Notification</span>
        <h2>ANJEL KLAXON™</h2>
        <p class="prose">
          A multi-channel emergency notification system designed to rapidly deliver alerts and keep
          teams informed when every second matters.
        </p>
        <p class="prose">
          Mass notification system built for speed, reliability, and reach—delivering critical
          alerts across any channel, anywhere.
        </p>
        <h3 class="tech-split__subhead">Highlights</h3>
        <ul class="feature-list">
          <li>Mass Notifications</li>
          <li>Multi-Channel Alerts</li>
          <li>Geo-Targeted Messaging</li>
        </ul>
        <a class="btn btn--ghost" href="/contact/">Request a Demo</a>
      </div>
      <img
        src="/images/step-3-notify-command.png"
        alt="Command center receiving mass notification alerts"
        width="560"
        loading="lazy"
        class="tech-split__photo"
      />
    </div>
  </section>

  <section class="section" id="ai-platform">
    <div class="container tech-split">
      <div>
        <span class="eyebrow">AI &amp; Analytics</span>
        <h2>AI Intelligence Platform</h2>
        <p class="prose">
          An intelligent analytics platform that transforms operational data into actionable
          insights for faster, more informed decision-making.
        </p>
        <p class="prose">
          AI-powered platform that fuses data from multiple sources to deliver predictive insights,
          automate analysis, and support mission-critical decisions.
        </p>
        <h3 class="tech-split__subhead">Highlights</h3>
        <ul class="feature-list">
          <li>AI Analytics</li>
          <li>Predictive Insights</li>
          <li>Decision Support</li>
        </ul>
        <a class="btn btn--ghost" href="/contact/">Connect With Our Team</a>
      </div>
      <img
        src="/images/step-4-coordinate-response.png"
        alt="AI analytics console with live incident data"
        width="560"
        loading="lazy"
        class="tech-split__photo"
      />
    </div>
  </section>

  <section class="section section--variant" id="our-technology">
    <div class="container">
      <SectionHeading eyebrow="Our Technology" title="The Pluribus portfolio" />

      <div class="portfolio">
        <article id="big-data">
          <span class="eyebrow">01 / Big Data</span>
          <p class="prose">
            Pluribus Inc. is a big data, geosocial &amp; geospatial analytics company. Founded in
            2019, we specialize in making the complex simple, the obscure plain and the unknown
            known. We do this through a combination of talent and technology, all to derive keen
            insights that help you live a better life.
          </p>
        </article>

        <article id="ibn">
          <span class="eyebrow">02 / IBN®</span>
          <p class="prose">
            Identity-Based Navigation® is our specialty, focusing on your unique characteristics
            and how they relate, correlate and interrelate within the settings of your preference,
            present and future. We help YOU navigate more efficiently and productively; we give you
            insights about where you are (or plan to go), based on who YOU are; and we bring a
            personalized and optimized world to you, based on who YOU are.
          </p>
          <a class="btn btn--ghost" href="/identity-based-navigation/">
            Identity-Based Navigation®, IBN™ &amp; OurWays™
          </a>
        </article>

        <article id="ourways">
          <span class="eyebrow">03 / OurWays™</span>
          <p class="prose">
            OurWays™ is a 21st-century, A.I. &amp; 5G-enabled, geosocial, navigation application
            currently under development by our award-winning team of full-stack developers, data
            scientists, research psychologists, geospatial analysts and innovation experts.
            OurWays™ will incrementally deliver a revolutionary technology and capability to each
            and every person in the world, making the world a safer and better place for all. That
            is our dream; that is our vision; that is our mission; and that is our overwhelming and
            obsessive passion!
          </p>
        </article>

        <article id="anjel-tech">
          <span class="eyebrow">04 / ANJEL® Tech</span>
          <p class="prose">
            Designed for individual and family security, ANJEL Tech is a cloud-based, GPS-enabled,
            live-streaming and recording, Personal Security Service. We created ANJEL Tech to
            provide you and your loved ones with additional safety and security; to help your
            children live and grow into adulthood, meeting their expected life milestones (school
            graduation, marriage, family / children, career, home ownership, etc.); and to help you
            and your loved ones preserve your inalienable rights to life, liberty, and the pursuit
            of happiness.
          </p>
          <a class="btn btn--ghost" href="https://www.anjel.tech" rel="noopener" target="_blank">
            Visit www.anjel.tech for more information ↗
          </a>
        </article>
      </div>
    </div>
  </section>

  <section class="section cta-band">
    <div class="container">
      <hr class="hairline" />
      <div class="cta-band__body">
        <h2>Ready to see Pluribus in action?</h2>
        <div class="cta-band__actions">
          <a class="btn btn--solid" href="/contact/">Request a Demo</a>
          <a class="btn btn--ghost" href="/capabilities/">Explore Capabilities</a>
        </div>
      </div>
      <hr class="hairline" />
    </div>
  </section>
</Base>

<style>
  .tech-split {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  @media (max-width: 860px) {
    .tech-split {
      grid-template-columns: 1fr;
    }
  }

  .tech-split__emblem {
    max-width: 340px;
    justify-self: center;
  }

  .tech-split__photo {
    border-radius: var(--radius-lg);
    justify-self: center;
  }

  .tech-split__subhead {
    margin-top: 1.5rem;
  }

  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 1.75rem;
    display: grid;
    gap: 0.4rem;
  }

  .feature-list li::before {
    content: '—';
    color: var(--accent-readable);
    margin-right: 0.6rem;
  }

  .tagline-band {
    text-align: center;
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .tagline-band__text {
    font-family: var(--font-display);
    font-size: var(--size-h2);
    font-weight: 600;
    color: var(--heading);
    margin: 0;
  }

  .tagline-band strong {
    color: var(--brand-light);
  }

  .portfolio {
    display: grid;
    gap: 3rem;
  }

  .portfolio article .btn {
    margin-top: 0.5rem;
  }

  .cta-band__body {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: clamp(2rem, 4vw, 3rem);
  }

  .cta-band__body h2 {
    margin: 0;
  }

  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>
