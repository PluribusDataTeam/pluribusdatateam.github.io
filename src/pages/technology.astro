---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import bigDataImage from '../assets/images/tech-big-data.jpg';
import anjelLogo from '../assets/images/logo-anjel.png';
import guardianLogo from '../assets/images/logo-guardian-anjel.png';

const index = [
  { id: 'big-data', n: '01', name: 'Big Data' },
  { id: 'ibn', n: '02', name: 'IBN®' },
  { id: 'ourways', n: '03', name: 'OurWays™' },
  { id: 'anjel-tech', n: '04', name: 'ANJEL® Tech' },
  { id: 'guardian-anjel', n: '05', name: 'Guardian ANJEL®' },
];
---

<Base
  title="Our Technology | Pluribus Inc"
  description="Big Data, Identity-Based Navigation®, OurWays™, ANJEL® Tech and Guardian ANJEL® — the Pluribus technology portfolio."
>
  <section class="page-head">
    <div class="grid-bg"></div>
    <div class="container">
      <span class="eyebrow">Our Technology</span>
      <h1>Providing a personalized, safer world for each person!</h1>
      <div class="page-head__meta">
        {index.map((i) => <span>{i.n} {i.name}</span>)}
      </div>
    </div>
  </section>

  <div class="container tech">
    <aside class="tech__index">
      <p class="eyebrow eyebrow--plain">Index</p>
      <ol>
        {index.map((i) => (
          <li>
            <a href={`#${i.id}`} data-index-link={i.id}>
              <span class="mono">{i.n}</span> {i.name}
            </a>
          </li>
        ))}
      </ol>
    </aside>

    <div class="tech__body">
      <article class="tech-item reveal" id="big-data">
        <span class="eyebrow">01 / Big Data</span>
        <h2>Big data, geosocial &amp; geospatial analytics</h2>
        <div class="tech-item__grid">
          <p class="prose">
            Pluribus Inc. is a big data, geosocial &amp; geospatial analytics company. Founded in
            2019, we specialize in making the complex simple, the obscure plain and the unknown
            known. We do this through a combination of talent and technology, all to derive keen
            insights that help you live a better life.
          </p>
          <figure class="tech-item__figure reticle">
            <Image src={bigDataImage} alt="Data analytics visualization" width="880" />
          </figure>
        </div>
      </article>

      <article class="tech-item reveal" id="ibn">
        <span class="eyebrow">02 / IBN®</span>
        <h2>Identity-Based Navigation®</h2>
        <p class="prose">
          Identity-Based Navigation® is our specialty, focusing on your unique characteristics and
          how they relate, correlate and interrelate within the settings of your preference, present
          and future. We help YOU navigate more efficiently and productively; we give you insights
          about where you are (or plan to go), based on who YOU are; and we bring a personalized and
          optimized world to you, based on who YOU are.
        </p>
        <a class="btn btn--ghost" href="/identity-based-navigation/">Deep dive: IBN® &amp; OurWays™ <Arrow /></a>
      </article>

      <article class="tech-item reveal" id="ourways">
        <span class="eyebrow">03 / OurWays™</span>
        <h2>OurWays™</h2>
        <p class="prose">
          OurWays™ is a 21st-century, A.I. &amp; 5G-enabled, geosocial, navigation application
          currently under development by our award-winning team of full-stack developers, data
          scientists, research psychologists, geospatial analysts and innovation experts. OurWays™
          will incrementally deliver a revolutionary technology and capability to each and every
          person in the world, making the world a safer and better place for all. That is our dream;
          that is our vision; that is our mission; and that is our overwhelming and obsessive
          passion!
        </p>
      </article>

      <article class="tech-item reveal" id="anjel-tech">
        <span class="eyebrow">04 / ANJEL® Tech</span>
        <h2>ANJEL® Tech</h2>
        <div class="tech-item__grid tech-item__grid--logo">
          <div>
            <p class="prose">
              Designed for individual and family security, ANJEL Tech is a cloud-based, GPS-enabled,
              live-streaming and recording, Personal Security Service. We created ANJEL Tech to provide
              you and your loved ones with additional safety and security; to help your children live
              and grow into adulthood, meeting their expected life milestones (school graduation,
              marriage, family / children, career, home ownership, etc.); and to help you and your
              loved ones preserve your inalienable rights to life, liberty, and the pursuit of
              happiness.
            </p>
            <a class="btn btn--ghost" href="https://www.anjel.tech" rel="noopener" target="_blank">
              Visit anjel.tech <Arrow />
            </a>
          </div>
          <div class="tech-item__logo tech-item__logo--gold">
            <Image src={anjelLogo} alt="ANJEL Tech lens logo" width="360" height="360" />
          </div>
        </div>
      </article>

      <article class="tech-item reveal" id="guardian-anjel">
        <span class="eyebrow">05 / Guardian ANJEL®</span>
        <h2>Guardian ANJEL®</h2>
        <div class="tech-item__grid tech-item__grid--logo">
          <div class="prose">
            <p>
              Designed for military installation security, Guardian ANJEL enhances military security
              with real-time, first-person intelligence. Turning every smartphone into a GPS-enabled,
              live-streaming, incident-reporting tool, we empower Security Forces to respond faster and
              smarter. Because when seconds matter, Guardian ANJEL delivers.
            </p>
            <p>
              Every military base in the world faces a universal challenge: when seconds matter most,
              the information needed to make critical decisions isn't always clear, timely, or
              actionable. This gap in situational awareness can jeopardize lives, missions, and the
              safety of military installations.
            </p>
            <p>
              At Guardian ANJEL, we are transforming the way Security Forces respond to threats by
              providing cutting-edge technology that delivers clarity and speed when it matters most.
            </p>
            <a class="btn btn--ghost" href="https://www.guardiananjel.com" rel="noopener" target="_blank">
              Visit guardiananjel.com <Arrow />
            </a>
          </div>
          <div class="tech-item__logo tech-item__logo--blue">
            <Image src={guardianLogo} alt="Guardian ANJEL iris logo" width="360" height="360" />
          </div>
        </div>
      </article>
    </div>
  </div>

  <section class="tagline">
    <div class="grid-bg"></div>
    <div class="container">
      <p class="tagline__text reveal">
        See Something<span>-</span>Say Something<span>-</span><strong>STREAM Something!™</strong>
      </p>
    </div>
  </section>

  <script>
    // Highlight the index entry for the section in view.
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-index-link]');
    const items = document.querySelectorAll<HTMLElement>('.tech-item');
    if ('IntersectionObserver' in window && links.length) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              links.forEach((l) => l.classList.toggle('is-active', l.dataset.indexLink === e.target.id));
            }
          }
        },
        { rootMargin: '-40% 0px -50% 0px' },
      );
      items.forEach((el) => io.observe(el));
    }
  </script>
</Base>

<style>
  .page-head h1 {
    max-width: 18ch;
  }

  .tech {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    padding-block: var(--section);
  }

  @media (max-width: 900px) {
    .tech {
      grid-template-columns: 1fr;
    }

    .tech__index {
      display: none;
    }
  }

  .tech__index {
    position: sticky;
    top: calc(76px + 2rem);
    align-self: start;
  }

  .tech__index ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--line);
  }

  .tech__index a {
    display: flex;
    gap: 0.75rem;
    padding: 0.55rem 0 0.55rem 1rem;
    margin-left: -1px;
    border-left: 2px solid transparent;
    font-family: var(--font-display);
    font-weight: 560;
    font-size: var(--fs--1);
    color: var(--muted);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .tech__index a .mono {
    color: var(--signal);
    font-size: var(--fs--2);
    padding-top: 0.15rem;
  }

  .tech__index a:hover,
  .tech__index a.is-active {
    color: var(--text);
    border-left-color: var(--signal);
  }

  .tech__body {
    display: flex;
    flex-direction: column;
    gap: clamp(3.5rem, 8vw, 7rem);
  }

  .tech-item {
    scroll-margin-top: calc(76px + 2rem);
  }

  .tech-item h2 {
    max-width: 18ch;
    margin-bottom: 1.5rem;
  }

  .tech-item .btn {
    margin-top: 0.5rem;
  }

  .tech-item__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }

  .tech-item__grid--logo {
    grid-template-columns: minmax(0, 1fr) 260px;
    align-items: center;
  }

  @media (max-width: 760px) {
    .tech-item__grid,
    .tech-item__grid--logo {
      grid-template-columns: 1fr;
    }
  }

  .tech-item__figure {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .tech-item__figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85);
  }

  .tech-item__logo {
    position: relative;
    justify-self: center;
    width: 220px;
  }

  .tech-item__logo::before {
    content: '';
    position: absolute;
    inset: -25%;
    border-radius: 50%;
    filter: blur(36px);
    opacity: 0.4;
  }

  .tech-item__logo--gold::before { background: #c8963e; }
  .tech-item__logo--blue::before { background: #2f7fd6; }

  .tech-item__logo img {
    position: relative;
  }

  .tagline {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 9vw, 7rem);
    background: var(--ink-950);
    border-top: 1px solid var(--line);
    text-align: center;
  }

  .tagline__text {
    position: relative;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 640;
    font-size: var(--fs-4);
    letter-spacing: -0.03em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .tagline__text span {
    color: var(--muted);
    padding-inline: 0.35em;
    font-weight: 300;
  }

  .tagline__text strong {
    color: var(--signal);
    font-weight: 700;
  }
</style>
