---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import ibnImage from '../assets/images/ibn.jpg';
---

<Base
  title="Identity-Based Navigation | Pluribus Inc"
  description="Identity-Based Navigation®, IBN™ & OurWays™ — a provisionally-patented technology providing a personalized world to each person."
>
  <section class="ibn-hero">
    <div class="ibn-hero__media">
      <Image src={ibnImage} alt="" width="1600" loading="eager" fetchpriority="high" />
    </div>
    <div class="ibn-hero__scrim"></div>
    <div class="container ibn-hero__content">
      <span class="eyebrow">Our Specialty</span>
      <h1>Identity-Based Navigation®, IBN™ &amp; OurWays™</h1>
      <div class="page-head__meta">
        <span>Provisionally patented</span>
        <span>Software-as-a-Service</span>
        <span>Geospatial · Geosocial</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container ibn-grid">
      <div class="ibn-grid__rail">
        <p class="eyebrow eyebrow--plain">IBN™ in brief</p>
        <ol class="ibn-steps mono">
          <li><span>01</span> Collect, compile and collate</li>
          <li><span>02</span> Geospatial and geosocial insights</li>
          <li><span>03</span> Preferred routing and “match-making”</li>
          <li><span>04</span> Your ideal/personalized world</li>
        </ol>
      </div>

      <div class="prose ibn-prose">
        <p class="reveal">
          OurWays™ is a Software-as-a-Service (SaaS) application that uses a provisionally-patented
          technology called Identity-Based Navigation™ (also known as IBN™) to collect, compile and
          collate data about product and service-providing businesses, combined with the traits
          that make people unique.
        </p>
        <p class="reveal">
          This data is analyzed for research and business purposes, to derive geospatial and
          geosocial data and insights about people, places and things that have common points of
          connection and preference. We also evaluate crime data and statistics at the micro and
          macro levels to understand and relay potential safety concerns (in each environment) that
          are equally and uniquely tailored.
        </p>
        <p class="reveal">
          Understanding these commonalities between people, their environment and nearby product
          and service providers, we design preferred routing and “match-making” between people,
          their needs, their destinations and the collocated product and service providers.
        </p>
        <p class="reveal ibn-prose__you">
          What makes this special and unique is YOU. Everything that makes you unique and
          “one-of-a-kind” can and should be used to develop your ideal/personalized world and
          provide it directly to YOU. And, that’s exactly what we’re doing, all for YOU!
        </p>
      </div>
    </div>
  </section>

  <section class="section paper ibn-cta">
    <div class="container ibn-cta__inner reveal">
      <p class="ibn-cta__text">Providing a personalized world to each person.</p>
      <a class="btn btn--dark" href="/contact/">Request More Information <Arrow /></a>
    </div>
  </section>
</Base>

<style>
  .ibn-hero {
    position: relative;
    min-height: min(70vh, 640px);
    display: flex;
    align-items: flex-end;
    background: var(--ink-950);
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .ibn-hero__media {
    position: absolute;
    inset: 0;
  }

  .ibn-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    opacity: 0.55;
  }

  .ibn-hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(5, 7, 11, 0.4), rgba(5, 7, 11, 0.2) 40%, rgba(5, 7, 11, 0.95)),
      linear-gradient(90deg, rgba(5, 7, 11, 0.6), transparent 60%);
  }

  .ibn-hero__content {
    position: relative;
    padding-block: clamp(6rem, 14vw, 10rem) clamp(2.5rem, 6vw, 4rem);
  }

  .ibn-hero h1 {
    max-width: 16ch;
  }

  .ibn-grid {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  @media (max-width: 860px) {
    .ibn-grid {
      grid-template-columns: 1fr;
    }
  }

  .ibn-grid__rail {
    position: sticky;
    top: calc(76px + 2rem);
  }

  .ibn-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .ibn-steps li {
    display: flex;
    gap: 0.9rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--text-2);
    font-size: var(--fs--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ibn-steps span {
    color: var(--signal);
  }

  .ibn-prose {
    max-width: 66ch;
    font-size: var(--fs-1);
  }

  .ibn-prose__you {
    padding: 1.5rem;
    border-left: 3px solid var(--signal);
    background: var(--ink-800);
    border-radius: 0 var(--radius) var(--radius) 0;
    color: var(--text);
  }

  .ibn-cta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .ibn-cta__text {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 640;
    font-size: var(--fs-3);
    letter-spacing: -0.03em;
    line-height: 1.05;
    max-width: 18ch;
  }
</style>
