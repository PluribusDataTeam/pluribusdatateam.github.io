---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
---

<Base title="Page Not Found | Pluribus Inc">
  <section class="not-found">
    <div class="grid-bg"></div>
    <div class="container not-found__inner">
      <p class="mono not-found__code">ERR 404 · NO FIX</p>
      <h1 class="display">Off the map.</h1>
      <p class="lead">The page you're looking for doesn't exist or has moved.</p>
      <a class="btn btn--primary" href="/">Back to Home <Arrow /></a>
    </div>
  </section>
</Base>

<style>
  .not-found {
    position: relative;
    overflow: hidden;
    padding-block: clamp(8rem, 18vw, 14rem);
    background: var(--ink-950);
    text-align: center;
  }

  .not-found__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .not-found__code {
    color: var(--signal);
    letter-spacing: 0.18em;
    margin-bottom: 1.5rem;
  }

  .not-found .lead {
    margin-bottom: 2rem;
  }
</style>
