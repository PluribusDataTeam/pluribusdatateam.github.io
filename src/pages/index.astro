---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import SectionHead from '../components/SectionHead.astro';
import anjelLogo from '../assets/images/logo-anjel.png';
import guardianLogo from '../assets/images/logo-guardian-anjel.png';

const capabilities = [
  {
    n: '01',
    name: 'Big Data',
    href: '/technology/#big-data',
    text: 'Founded in 2019, we specialize in making the complex simple, the obscure plain and the unknown known. We do this through a combination of talent and technology, all to derive keen insights that help you live a better life.',
  },
  {
    n: '02',
    name: 'IBN®',
    href: '/identity-based-navigation/',
    text: 'Identity-Based Navigation® is our specialty, focusing on your unique characteristics and how they relate, correlate and interrelate within the settings of your preference, present and future.',
  },
  {
    n: '03',
    name: 'OurWays™',
    href: '/technology/#ourways',
    text: 'OurWays™ is a 21st-century, A.I. & 5G-enabled, geosocial, navigation application currently under development by our award-winning team of full-stack developers, data scientists, research psychologists, geospatial analysts and innovation experts.',
  },
  {
    n: '04',
    name: 'ANJEL® Tech',
    href: 'https://www.anjel.tech',
    external: true,
    text: 'Designed for individual and family security, ANJEL Tech is a cloud-based, GPS-enabled, live-streaming and recording, Personal Security Service.',
  },
  {
    n: '05',
    name: 'Guardian ANJEL®',
    href: 'https://www.guardiananjel.com',
    external: true,
    text: 'Designed for military installation security, Guardian ANJEL enhances military security with real-time, first-person intelligence. Turning every smartphone into a GPS-enabled, live-streaming, incident-reporting tool, we empower Security Forces to respond faster and smarter. Because when seconds matter, Guardian ANJEL delivers.',
  },
];

const ticker = ['Big Data', 'Geosocial Analytics', 'Geospatial Analytics', 'Identity-Based Navigation®', 'OurWays™', 'ANJEL® Tech', 'Guardian ANJEL®'];
---

<Base title="Pluribus Inc. | Big Data, Geosocial & Geospatial Analytics" overlay>
  <!-- Hero ------------------------------------------------------------ -->
  <section class="hero" id="top">
    <div class="hero__map" aria-hidden="true">
      <canvas data-geomap></canvas>
      <div class="hero__scrim"></div>
    </div>

    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="eyebrow reveal is-in">Big data · Geosocial · Geospatial analytics</p>
        <h1 class="display reveal is-in" data-split>
          Providing a personalized, <span class="accent">safer world</span> for each person!
        </h1>
        <p class="lead reveal is-in" data-delay="3">
          Pluribus Inc. is a big data, geosocial &amp; geospatial analytics company.
        </p>
        <div class="hero__actions reveal is-in" data-delay="4">
          <a class="btn btn--primary" href="/technology/">Explore Our Technology <Arrow /></a>
          <a class="btn btn--ghost" href="/contact/">Get in Touch</a>
        </div>
      </div>

      <dl class="hero__facts reveal is-in" data-delay="5">
        <div><dt>Founded</dt><dd>2019</dd></div>
        <div><dt>Headquarters</dt><dd>McLean, Virginia</dd></div>
        <div><dt>Specialty</dt><dd>Identity-Based Navigation®</dd></div>
        <div class="hero__facts-hint mono"><span class="hero__dot"></span> Move your cursor across the map</div>
      </dl>
    </div>

    <div class="ticker" aria-hidden="true">
      <div class="ticker__track">
        {[...ticker, ...ticker].map((t) => <span class="ticker__item">{t}</span>)}
      </div>
    </div>
  </section>

  <!-- Capabilities ---------------------------------------------------- -->
  <section class="section" id="what-we-build">
    <div class="container">
      <SectionHead eyebrow="Our Technology" title="What we build" aside="01 — 05" />

      <ol class="caps">
        {
          capabilities.map((c, i) => (
            <li class="reveal" data-delay={String(Math.min(i + 1, 5))}>
              <a
                class="caps__row"
                data-spotlight
                href={c.href}
                target={c.external ? '_blank' : undefined}
                rel={c.external ? 'noopener' : undefined}
              >
                <span class="caps__n mono">{c.n}</span>
                <h3 class="caps__name">{c.name}</h3>
                <p class="caps__text">{c.text}</p>
                <span class="caps__cta link">
                  {c.external ? 'Visit site' : 'Learn more'}
                  <Arrow />
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Mission (paper) -------------------------------------------------- -->
  <section class="section paper mission">
    <div class="container">
      <div class="mission__grid">
        <div class="mission__main reveal">
          <span class="eyebrow">Our Mission</span>
          <p class="mission__text" data-words>
            We were created to tell every person in the world where they are, based on who they are;
            to help every person in the world make smarter decisions about where they go and how they
            get there, based on who they are; to make the world a safer and better place for each and
            every person, based on who they are; and to lead the world in Identity-Based Navigation®.
          </p>
          <a class="btn btn--dark" href="/about/">More about us <Arrow /></a>
        </div>

        <aside class="mission__vision reveal" data-delay="2" data-tilt="4">
          <span class="eyebrow">Our Vision</span>
          <p class="mission__vision-text">
            Intelligent, Identity-Based Navigation® for human- and machinekind.
          </p>
          <svg class="mission__mark" viewBox="0 0 120 120" fill="none" aria-hidden="true">
            <circle cx="60" cy="60" r="56" stroke="currentColor" stroke-opacity="0.18" />
            <circle cx="60" cy="60" r="36" stroke="currentColor" stroke-opacity="0.28" stroke-dasharray="3 5" />
            <path d="M60 4v20M60 96v20M4 60h20M96 60h20" stroke="currentColor" stroke-opacity="0.4" />
            <circle cx="60" cy="60" r="5" fill="currentColor" />
          </svg>
        </aside>
      </div>
    </div>
  </section>

  <!-- Products --------------------------------------------------------- -->
  <section class="section products">
    <div class="container">
      <SectionHead eyebrow="04 / 05" title="ANJEL® Tech & Guardian ANJEL®" aside="anjel.tech · guardiananjel.com" />

      <div class="products__grid">
        <a class="product reveal" href="https://www.anjel.tech" rel="noopener" target="_blank" data-delay="1" data-tilt="5">
          <div class="product__logo product__logo--gold float">
            <Image src={anjelLogo} alt="" width="320" height="320" />
          </div>
          <div class="product__body">
            <span class="eyebrow">04 / ANJEL® Tech</span>
            <h3>ANJEL® Tech</h3>
            <p>
              Designed for individual and family security, ANJEL Tech is a cloud-based, GPS-enabled,
              live-streaming and recording, Personal Security Service.
            </p>
            <span class="link">Visit anjel.tech <Arrow /></span>
          </div>
        </a>

        <a class="product reveal" href="https://www.guardiananjel.com" rel="noopener" target="_blank" data-delay="2" data-tilt="5">
          <div class="product__logo product__logo--blue float float--late">
            <Image src={guardianLogo} alt="" width="320" height="320" />
          </div>
          <div class="product__body">
            <span class="eyebrow">05 / Guardian ANJEL®</span>
            <h3>Guardian ANJEL®</h3>
            <p>
              Designed for military installation security, Guardian ANJEL enhances military security
              with real-time, first-person intelligence. Turning every smartphone into a GPS-enabled,
              live-streaming, incident-reporting tool, we empower Security Forces to respond faster and
              smarter. Because when seconds matter, Guardian ANJEL delivers.
            </p>
            <span class="link">Visit guardiananjel.com <Arrow /></span>
          </div>
        </a>
      </div>

      <p class="products__tagline reveal" data-split>
        See Something - Say Something - <strong>STREAM Something!™</strong>
      </p>
    </div>
  </section>

  <!-- CTA -------------------------------------------------------------- -->
  <section class="section section--tight">
    <div class="container">
      <div class="cta reticle reveal" data-spotlight>
        <div class="grid-bg"></div>
        <div class="cta__inner">
          <div>
            <span class="eyebrow">Request More Info</span>
            <h2>Connect with us!</h2>
          </div>
          <a class="btn btn--primary" href="/contact/">Contact Us <Arrow /></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero ----------------------------------------------------------- */

  .hero {
    position: relative;
    background: var(--ink-950);
    padding-top: calc(76px + clamp(3.5rem, 9vw, 7rem));
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    min-height: min(92vh, 900px);
    display: flex;
    flex-direction: column;
  }

  .hero__map {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__map canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(5, 7, 11, 0.92) 0%, rgba(5, 7, 11, 0.75) 35%, rgba(5, 7, 11, 0.15) 65%, rgba(5, 7, 11, 0) 100%),
      linear-gradient(180deg, rgba(5, 7, 11, 0.6) 0%, rgba(5, 7, 11, 0) 30%, rgba(5, 7, 11, 0) 70%, rgba(5, 7, 11, 0.9) 100%);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
    gap: clamp(3rem, 8vw, 6rem);
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
    pointer-events: none;
  }

  .hero__inner a,
  .hero__inner .hero__copy {
    pointer-events: auto;
  }

  .hero__copy {
    max-width: 56rem;
  }

  .hero h1 {
    margin-bottom: 1.5rem;
    max-width: 14ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 1.5rem 3rem;
    margin: 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .hero__facts dt {
    font-family: var(--font-mono);
    font-size: var(--fs--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.25rem;
  }

  .hero__facts dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-0);
  }

  .hero__facts-hint {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    font-size: var(--fs--2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (hover: none) {
    .hero__facts-hint {
      display: none;
    }
  }

  .hero__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal);
    animation: dot-pulse 2s infinite;
  }

  @keyframes dot-pulse {
    0% { box-shadow: 0 0 0 0 rgba(198, 234, 61, 0.6); }
    70% { box-shadow: 0 0 0 8px rgba(198, 234, 61, 0); }
    100% { box-shadow: 0 0 0 0 rgba(198, 234, 61, 0); }
  }

  @media (max-width: 720px) {
    .hero {
      min-height: 0;
    }

    .hero__scrim {
      background:
        linear-gradient(180deg, rgba(5, 7, 11, 0.85) 0%, rgba(5, 7, 11, 0.7) 60%, rgba(5, 7, 11, 0.95) 100%);
    }
  }

  /* Ticker */
  .ticker {
    position: relative;
    border-top: 1px solid var(--line);
    padding-block: 0.9rem;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .ticker__track {
    display: flex;
    gap: 3rem;
    width: max-content;
    animation: ticker 40s linear infinite;
  }

  .ticker__item {
    font-family: var(--font-mono);
    font-size: var(--fs--2);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }

  .ticker__item::before {
    content: '◆';
    color: var(--signal);
    font-size: 0.55em;
    margin-right: 3rem;
    vertical-align: middle;
  }

  @keyframes ticker {
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker__track { animation: none; }
  }

  /* Capabilities --------------------------------------------------- */

  .caps {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .caps__row {
    border-radius: var(--radius);
    display: grid;
    grid-template-columns: 4rem minmax(0, 0.9fr) minmax(0, 1.6fr) auto;
    gap: 1.5rem 2.5rem;
    align-items: start;
    padding: clamp(1.5rem, 3vw, 2.25rem) 0;
    border-bottom: 1px solid var(--line);
    color: var(--text);
    position: relative;
    transition: padding-left 0.3s var(--ease-out);
  }

  .caps__row::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: -1px;
    width: 3px;
    background: var(--signal);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.3s var(--ease-out);
  }

  .caps__row:hover {
    padding-left: 1.25rem;
  }

  .caps__row:hover::before {
    transform: scaleY(1);
  }

  .caps__n {
    color: var(--signal);
    font-size: var(--fs--1);
    padding-top: 0.5rem;
  }

  .caps__name {
    font-size: var(--fs-2);
    margin: 0;
  }

  .caps__text {
    margin: 0;
    color: var(--text-2);
    max-width: 62ch;
    text-wrap: pretty;
  }

  .caps__cta {
    padding-top: 0.4rem;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .caps__row:hover .caps__cta {
    opacity: 1;
  }

  @media (max-width: 860px) {
    .caps__row {
      grid-template-columns: 3rem minmax(0, 1fr);
      gap: 0.75rem 1rem;
    }

    .caps__text,
    .caps__cta {
      grid-column: 2;
    }

    .caps__row:hover {
      padding-left: 0.75rem;
    }
  }

  /* Mission -------------------------------------------------------- */

  .mission {
    background-image: radial-gradient(rgba(10, 13, 19, 0.16) 1px, transparent 1px);
    background-size: 22px 22px;
  }

  .mission__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: stretch;
  }

  @media (max-width: 860px) {
    .mission__grid {
      grid-template-columns: 1fr;
    }
  }

  .mission__text {
    font-family: var(--font-display);
    font-weight: 520;
    font-size: var(--fs-2);
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--paper-text);
    margin-bottom: 2.25rem;
    text-wrap: pretty;
  }

  .mission__vision {
    position: relative;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    border: 1px solid var(--paper-line);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.55);
    overflow: hidden;
  }

  .mission__vision-text {
    font-family: var(--font-display);
    font-weight: 640;
    font-size: var(--fs-2);
    line-height: 1.15;
    letter-spacing: -0.025em;
    margin: 0;
    max-width: 16ch;
    position: relative;
  }

  .mission__mark {
    position: absolute;
    right: -10px;
    bottom: -10px;
    width: 46%;
    color: var(--paper-text);
    opacity: 0.5;
  }

  /* Products ------------------------------------------------------- */

  .products__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 860px) {
    .products__grid {
      grid-template-columns: 1fr;
    }
  }

  .product {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 1.75rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, var(--ink-800), var(--ink-900));
    color: var(--text);
    transition: border-color 0.3s ease, transform 0.4s var(--ease-out);
  }

  .product:hover {
    border-color: var(--line-strong);
    transform: translateY(-4px);
  }

  @media (max-width: 560px) {
    .product {
      grid-template-columns: 1fr;
    }
  }

  .product__logo {
    position: relative;
    align-self: start;
    border-radius: 50%;
  }

  .product__logo::before {
    content: '';
    position: absolute;
    inset: -20%;
    border-radius: 50%;
    filter: blur(28px);
    opacity: 0.35;
    z-index: 0;
    transition: opacity 0.4s ease;
  }

  .product:hover .product__logo::before {
    opacity: 0.6;
  }

  .product__logo--gold::before { background: #c8963e; }
  .product__logo--blue::before { background: #2f7fd6; }

  .product__logo img {
    position: relative;
    width: 150px;
    height: 150px;
  }

  .product__body h3 {
    font-size: var(--fs-2);
  }

  .product__body p {
    color: var(--text-2);
    text-wrap: pretty;
  }

  .products__tagline {
    margin: clamp(3rem, 6vw, 5rem) 0 0;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-2);
    letter-spacing: -0.02em;
    color: var(--text-2);
  }

  .products__tagline strong {
    color: var(--signal);
    font-weight: 700;
  }

  /* CTA ------------------------------------------------------------ */

  .cta {
    position: relative;
    overflow: hidden;
    padding: clamp(2.5rem, 6vw, 4.5rem);
    border: 1px solid var(--line-strong);
    background: var(--ink-950);
  }

  .cta .grid-bg {
    mask-image: radial-gradient(ellipse at 10% 50%, #000 10%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse at 10% 50%, #000 10%, transparent 70%);
  }

  .cta__inner {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .cta h2 {
    margin: 0;
  }
</style>
