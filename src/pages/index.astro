---
import Base from '../layouts/Base.astro';

const environments = [
  {
    title: 'Government',
    sub: 'Mission Operations',
    href: '/environments/#government',
    image: '/images/env-government.png',
    alt: 'United States Capitol dome behind an American flag',
  },
  {
    title: 'Enterprise',
    sub: 'Connected Operations',
    href: '/environments/#enterprise',
    image: '/images/hero-night-ops.png',
    alt: 'Operations leader reviewing a live map dashboard over a city at night',
  },
  {
    title: 'Public Safety',
    sub: 'Emergency Response',
    href: '/environments/#public-safety',
    image: '/images/step-5-respond-resolve.png',
    alt: 'Police, fire, and EMS teams coordinating at an active incident',
  },
  {
    title: 'Critical Infrastructure',
    sub: 'Essential Services',
    href: '/environments/#critical-infrastructure',
    image: '/images/step-3-notify-command.png',
    alt: 'Command center operators monitoring infrastructure dashboards',
  },
];

const oodaSteps = [
  { name: 'Observe', text: 'Collect and detect data in real time.', icon: 'eye' },
  { name: 'Orient', text: "Fuse and analyze to understand what's happening.", icon: 'compass' },
  { name: 'Decide', text: 'Generate insights and determine the best course of action.', icon: 'check' },
  { name: 'Act', text: 'Deliver information and enable decisive action in the field.', icon: 'rocket' },
];

const products = [
  {
    name: 'Guardian ANJEL™',
    text: 'A real-time situational awareness platform that helps improve safety, communication, and coordinated response during critical events.',
    highlights: ['Real-Time Awareness', 'Secure Communication', 'Live Location Sharing'],
    cta: 'Explore Guardian ANJEL',
    href: '/technologies/#guardian-anjel',
    image: '/images/product-guardian-anjel.png',
    alt: 'Person activating a personal safety alert on a smartphone on a city street at dusk',
  },
  {
    name: 'ANJEL KLAXON™',
    text: 'A multi-channel emergency notification system designed to rapidly deliver alerts and keep teams informed when every second matters.',
    highlights: ['Mass Notifications', 'Multi-Channel Alerts', 'Geo-Targeted Messaging'],
    cta: 'Explore ANJEL KLAXON',
    href: '/technologies/#anjel-klaxon',
    image: '/images/step-2-share-location.png',
    alt: 'Live location and alert map with connected devices',
  },
  {
    name: 'AI Intelligence Platform',
    text: 'An intelligent analytics platform that transforms operational data into actionable insights for faster, more informed decision-making.',
    highlights: ['AI Analytics', 'Predictive Insights', 'Decision Support'],
    cta: 'Explore AI Platform',
    href: '/technologies/#ai-platform',
    image: '/images/step-4-coordinate-response.png',
    alt: 'Analytics dashboard with live incident timeline and video feeds',
  },
];

const steps = [
  {
    n: 1,
    name: 'Detect & Report',
    text: 'Personnel identify an incident or potential threat using the Guardian ANJEL mobile app.',
    features: ['Mobile app', 'Emergency alert buttons', 'Drone alert', 'GPS location'],
    image: '/images/step-1-detect-report.png',
    alt: 'Field personnel reporting an incident from the Guardian ANJEL mobile app',
  },
  {
    n: 2,
    name: 'Share Location',
    text: "The user's location, status, and incident details are securely transmitted in real time.",
    features: ['Interactive map', 'GPS pins', 'Live tracking', 'Connected devices'],
    image: '/images/step-2-share-location.png',
    alt: 'Live map with GPS pins tracking a moving user',
  },
  {
    n: 3,
    name: 'Notify Command',
    text: 'Guardian ANJEL instantly alerts the appropriate command center with complete situational awareness.',
    features: ['Command center dashboard', 'Incident map', 'Live alerts', 'Monitoring screens'],
    image: '/images/step-3-notify-command.png',
    alt: 'Command center wall of monitoring screens showing an incident map',
  },
  {
    n: 4,
    name: 'Coordinate Response',
    text: 'Security teams communicate, monitor live updates, and coordinate the appropriate response.',
    features: ['Live chat', 'Video streaming', 'Team coordination', 'Incident timeline'],
    image: '/images/step-4-coordinate-response.png',
    alt: 'Secure chat, live video stream, and incident timeline in the Guardian ANJEL console',
  },
  {
    n: 5,
    name: 'Respond & Resolve',
    text: 'First responders receive actionable information to respond faster and improve operational outcomes.',
    features: ['Police', 'EMS', 'Fire response', 'Active incident'],
    image: '/images/step-5-respond-resolve.png',
    alt: 'Police, EMS, and fire units responding to an active incident',
  },
];

const whyCards = [
  {
    title: 'Secure by Design',
    text: 'Built with security-first architecture to support mission-critical environments where reliability and trust matter most.',
    icon: 'shield',
  },
  {
    title: 'Mission Focused',
    text: 'Purpose-built solutions designed for defense, public safety, emergency response, and critical infrastructure operations.',
    icon: 'pulse',
  },
  {
    title: 'AI-Powered Intelligence',
    text: 'Transform real-time operational data into actionable insights that enable faster, smarter decision-making.',
    icon: 'network',
  },
  {
    title: 'Built to Scale',
    text: 'Flexible technologies that integrate seamlessly with existing systems and grow alongside evolving mission needs.',
    icon: 'rocket',
  },
];

const trustedLogos = [
  { src: '/images/trusted/316th-wing.png', alt: '316th Wing' },
  { src: '/images/trusted/afsfc.png', alt: 'Air Force Security Forces Center' },
  { src: '/images/trusted/af-iimsc.png', alt: 'Air Force Installation and Mission Support Center' },
  { src: '/images/trusted/afwerx.png', alt: 'AFWERX' },
  { src: '/images/trusted/bespin.png', alt: 'BESPIN' },
  { src: '/images/trusted/chiefs-own.jpg', alt: "11th Wing — The Chief's Own" },
  { src: '/images/trusted/42d-air-base-wing.png', alt: '42d Air Base Wing' },
  { src: '/images/trusted/72d-air-base-wing.png', alt: '72d Air Base Wing' },
];

const news = [
  {
    title: 'Advancing AI for Mission-Critical Decision Support',
    image: '/images/step-4-coordinate-response.png',
  },
  {
    title: 'Connected Intelligence for Modern Security Operations',
    image: '/images/step-3-notify-command.png',
  },
  {
    title: 'Building Smarter, More Resilient Operational Networks',
    image: '/images/hero-night-ops.png',
  },
];

const icons: Record<string, string> = {
  eye: 'M12 5c-5 0-9 4.5-10 7 1 2.5 5 7 10 7s9-4.5 10-7c-1-2.5-5-7-10-7Zm0 11a4 4 0 1 1 0-8 4 4 0 0 1 0 8Z',
  compass: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm4 6-2.5 5.5L8 16l2.5-5.5L16 8Z',
  check: 'M4 4h16v16H4V4Zm4.7 8.3 2.3 2.3 4.8-5.2 1.4 1.4-6.2 6.6-3.7-3.7 1.4-1.4Z',
  rocket:
    'M13.5 3.6c2.6-1.2 5.4-1 6.6-.7.3 1.2.5 4-1 6.6-1.4 2.4-3.9 4.6-6.3 6l-3.3-3.3c1.4-2.4 3.6-6 4-8.6ZM5.6 14.2l4.2 4.2-1 2.6-3-1-2-2-1 -3 2.8-.8Z',
  shield:
    'M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3Zm-1.2 13.5-3-3 1.4-1.4 1.6 1.6 4-4.3 1.4 1.4-5.4 5.7Z',
  pulse: 'M3 12h4l2-6 4 12 2-6h6v-2h-4.5l-3.5 5-4-12-3.5 7H3v2Z',
  network:
    'M17 3a3 3 0 0 0-2.8 4.1l-4 2.4a3 3 0 1 0 0 5l4 2.4A3 3 0 1 0 15 15l-4-2.4c.1-.4.1-.8 0-1.2l4-2.4A3 3 0 1 0 17 3Z',
};
---

<Base title="Home | Pluribus Inc">
  <!-- 1. Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__inner">
      <div class="hero__copy">
        <h1 id="hero-title">
          Intelligence That Protects People, Infrastructure &amp; Critical Operations
        </h1>
        <p class="lead">
          AI-powered technologies for mission-critical decisions, situational awareness, and
          connected operations.
        </p>
        <div class="hero__actions">
          <a class="btn btn--solid" href="/technologies/">Explore Technologies</a>
          <a class="btn btn--ghost" href="/contact/">Request a Demo</a>
        </div>
        <p class="hero__tags">Government • Public Safety • Critical Infrastructure</p>
      </div>
    </div>
  </section>

  <!-- 2. Mission -->
  <section class="section section--deep mission" aria-labelledby="mission-title">
    <div class="container mission__inner">
      <hr class="hairline" />
      <span class="eyebrow">Our Mission</span>
      <h2 id="mission-title" class="mission__title">
        Protecting People Through Intelligent Technology.
      </h2>
    </div>
  </section>

  <!-- 3. Mission Environments -->
  <section class="section" aria-labelledby="environments-title">
    <div class="container">
      <span class="eyebrow">Mission Environments</span>
      <h2 id="environments-title">Built for the World's Most Critical Operations.</h2>
      <p class="lead">
        Supporting organizations with AI-powered technologies for safer, faster, and more informed
        decisions.
      </p>
      <ul class="env-grid">
        {
          environments.map((env) => (
            <li class="env-card">
              <a href={env.href}>
                <img src={env.image} alt={env.alt} loading="lazy" />
                <span class="env-card__caption">
                  <span class="env-card__text">
                    <span class="env-card__title">{env.title}</span>
                    <span class="env-card__sub">{env.sub}</span>
                  </span>
                  <span class="env-card__arrow" aria-hidden="true">→</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 4. Our Approach (OODA) -->
  <section class="section section--variant" aria-labelledby="approach-title">
    <div class="container approach">
      <div class="approach__intro">
        <span class="eyebrow">Our Approach</span>
        <h2 id="approach-title" class="approach__title">Observe.<br />Orient.<br />Decide.<br />Act.</h2>
        <p class="lead">Transforming real-time data into faster, smarter operational decisions.</p>
        <p class="approach__motto">Continuous Intelligence. Mission Impact.</p>
      </div>
      <ol class="approach__steps">
        {
          oodaSteps.map((step) => (
            <li class="approach__step">
              <span class="icon-disc icon-disc--outline" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d={icons[step.icon]} />
                </svg>
              </span>
              <h3>{step.name}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 5. Technologies by Pluribus -->
  <section class="section" aria-labelledby="technologies-title">
    <div class="container">
      <span class="eyebrow">Technologies by Pluribus</span>
      <h2 id="technologies-title">Mission-Ready Technologies. Built for Real-World Impact.</h2>
      <div class="products">
        {
          products.map((product) => (
            <article class="product-card">
              <img src={product.image} alt={product.alt} loading="lazy" />
              <div class="product-card__body">
                <div class="product-card__row">
                  <h3>{product.name}</h3>
                  <p>{product.text}</p>
                </div>
                <div class="product-card__row">
                  <h4>Highlights</h4>
                  <ul class="product-card__highlights">
                    {product.highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                </div>
                <a class="btn btn--ghost" href={product.href}>
                  {product.cta}
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6. How Guardian ANJEL Works -->
  <section class="section section--variant" aria-labelledby="how-title">
    <div class="container">
      <span class="eyebrow">Flagship Technology</span>
      <h2 id="how-title">How Guardian ANJEL Works.</h2>
      <p class="lead">
        Guardian ANJEL connects personnel, command centers, and responders through real-time
        communication, location awareness, and coordinated incident management.
      </p>
      <p class="how__slogan">See Something. Say Something. Stream Something.</p>
      <ol class="how-steps">
        {
          steps.map((step) => (
            <li class="how-step">
              <div class="how-step__number" aria-hidden="true">{step.n}.</div>
              <div class="how-step__head">
                <h3>{step.name}</h3>
              </div>
              <div class="how-step__detail">
                <p>{step.text}</p>
                <ul class="how-step__features">
                  {step.features.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
              </div>
              <img src={step.image} alt={step.alt} loading="lazy" width="320" height="320" />
            </li>
          ))
        }
      </ol>
      <a class="btn btn--ghost" href="/technologies/#guardian-anjel">Explore Guardian ANJEL</a>
    </div>
  </section>

  <!-- 7. Why Pluribus -->
  <section class="section" aria-labelledby="why-title">
    <div class="container why">
      <div class="why__intro">
        <span class="eyebrow">Why Pluribus</span>
        <h2 id="why-title">Mission-Driven Technology. Built for Critical Decisions.</h2>
        <p class="lead">
          Pluribus develops secure, AI-powered technologies that help governments, public safety
          agencies, and critical infrastructure organizations improve situational awareness,
          coordinate operations, and respond with confidence.
        </p>
        <img
          class="why__image"
          src="/images/product-guardian-anjel.png"
          alt="Guardian ANJEL personal safety alert in use on a city street"
          loading="lazy"
        />
      </div>
      <ul class="why__cards">
        {
          whyCards.map((card) => (
            <li class="card why__card">
              <span class="icon-disc" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d={icons[card.icon]} />
                </svg>
              </span>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 8. Founder Story -->
  <section class="section section--variant" aria-labelledby="founder-title">
    <div class="container founder">
      <figure class="founder__portrait">
        <img
          src="/images/founder-james-samuel.png"
          alt="James A. Samuel, Jr., Founder and CEO of Pluribus"
          loading="lazy"
        />
        <figcaption>
          <span class="eyebrow">Founded by</span>
          <strong>James A. Samuel, Jr.</strong>
          <span>Air Force Academy Graduate • Fighter Pilot</span>
        </figcaption>
      </figure>
      <div class="founder__story">
        <span class="eyebrow">Founder Story</span>
        <h2 id="founder-title">Mission Inspired. Built Through Experience.</h2>
        <p class="lead">
          After decades in military operations, James saw the need for smarter, mission-ready
          technologies.
        </p>
        <blockquote class="founder__quote">
          <p>“Why aren't we better prepared?”</p>
          <footer>The question that inspired Pluribus.</footer>
        </blockquote>
        <div class="founder__journey">
          <span class="eyebrow">Journey</span>
          <ol class="founder__milestones">
            <li>Military</li>
            <li>Aviation</li>
            <li>Mission Innovation</li>
            <li>Founded Pluribus</li>
          </ol>
        </div>
        <a class="btn btn--ghost" href="/company/">Meet the Team</a>
      </div>
    </div>
  </section>

  <!-- 9. Trusted By (light) -->
  <section class="section section--light" aria-labelledby="trusted-title">
    <div class="container">
      <span class="eyebrow">Trusted By</span>
      <h2 id="trusted-title">Protecting People Through Intelligent Technology.</h2>
      <ul class="logo-strip">
        {
          trustedLogos.map((logo) => (
            <li>
              <img src={logo.src} alt={logo.alt} loading="lazy" />
            </li>
          ))
        }
      </ul>
      <p class="logo-strip__disclaimer">
        The appearance of U.S. Department of Defense (DoD) visual information does not imply or
        constitute DoD endorsement.
      </p>
    </div>
  </section>

  <!-- 10. Latest Insights (light) -->
  <section class="section section--light insights" aria-labelledby="insights-title">
    <div class="container">
      <span class="eyebrow">Latest Insights</span>
      <h2 id="insights-title">News. Research. Innovations.</h2>
      <ul class="news-grid">
        {
          news.map((item) => (
            <li class="news-card">
              <a href="/insights/">
                <img src={item.image} alt="" loading="lazy" />
                <span class="news-card__title">{item.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--ghost" href="/insights/">View all</a>
    </div>
  </section>

  <!-- 11. CTA -->
  <section class="section cta" aria-labelledby="cta-title">
    <div class="container">
      <hr class="hairline" />
      <div class="cta__body">
        <div>
          <span class="eyebrow">Let's Build the Future Together</span>
          <h2 id="cta-title">Let's Build Smarter, Safer Operations.</h2>
          <p class="lead">
            Partner with Pluribus to deliver secure, intelligent solutions that make an impact
            where it matters most.
          </p>
        </div>
        <div class="cta__actions">
          <a class="btn btn--solid" href="/technologies/">Explore Technologies</a>
          <a class="btn btn--ghost" href="/contact/">Request a Demo</a>
        </div>
      </div>
      <hr class="hairline" />
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    background:
      linear-gradient(90deg, rgba(6, 11, 20, 0.94) 0%, rgba(6, 11, 20, 0.6) 55%, rgba(6, 11, 20, 0.3) 100%),
      url('/images/hero-night-ops.png') center / cover no-repeat;
    padding-block: clamp(5rem, 14vw, 11rem);
  }

  .hero__copy {
    max-width: 44rem;
  }

  .hero__copy h1 {
    margin-bottom: 0.6em;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-block: 2rem 1.5rem;
  }

  .hero__tags {
    color: var(--heading);
    font-weight: 700;
    letter-spacing: 0.06em;
    font-size: var(--size-caption);
    margin: 0;
  }

  .mission {
    background:
      linear-gradient(rgba(2, 4, 12, 0.55), rgba(2, 4, 12, 0.85)),
      url('/images/globe-dots.png') center / cover no-repeat;
  }

  .mission__inner {
    max-width: 56rem;
  }

  .mission .hairline {
    margin-bottom: 2.5rem;
  }

  .mission__title {
    font-size: var(--size-display-xl);
    font-weight: 700;
    margin-bottom: 0;
  }

  .env-grid {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1.5rem;
  }

  .env-card {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
  }

  .env-card a {
    display: block;
    color: inherit;
  }

  .env-card a:hover {
    text-decoration: none;
  }

  .env-card img {
    width: 100%;
    height: 16rem;
    object-fit: cover;
    transition: transform 200ms ease;
  }

  .env-card a:hover img,
  .env-card a:focus-visible img {
    transform: scale(1.03);
  }

  .env-card__caption {
    position: absolute;
    inset-inline: 1rem;
    bottom: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    background: rgba(0, 0, 0, 0.78);
    border-radius: var(--radius-lg);
    padding: 1rem 1.25rem;
  }

  .env-card__text {
    display: flex;
    flex-direction: column;
  }

  .env-card__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--size-h3);
    color: var(--heading);
  }

  .env-card__sub {
    color: var(--text);
  }

  .env-card__arrow {
    font-size: 1.5rem;
    color: var(--brand-light);
  }

  .approach {
    display: grid;
    grid-template-columns: minmax(16rem, 2fr) 3fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  @media (max-width: 900px) {
    .approach {
      grid-template-columns: 1fr;
    }
  }

  .approach__title {
    font-size: var(--size-display);
  }

  .approach__motto {
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: var(--size-caption);
    color: var(--heading);
  }

  .approach__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: 1.5rem;
  }

  .approach__step {
    padding: 1.25rem;
    border-radius: var(--radius);
  }

  .approach__step h3 {
    margin-block: 1rem 0.35rem;
  }

  .approach__step p {
    margin: 0;
    color: var(--text);
  }

  .icon-disc--outline {
    background: var(--bg-variant);
    border: 1.5px solid var(--brand-light);
    color: var(--brand-light);
  }

  .products {
    display: grid;
    gap: 2rem;
    margin-top: 2.5rem;
  }

  .product-card {
    border: 1px solid var(--outline-variant);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
  }

  .product-card > img {
    width: 100%;
    max-height: 26rem;
    object-fit: cover;
  }

  .product-card__body {
    padding: clamp(1.5rem, 3vw, 2rem);
    display: grid;
    gap: 1.5rem;
  }

  .product-card__row {
    display: grid;
    grid-template-columns: minmax(10rem, 1fr) 3fr;
    gap: 1rem 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--outline-variant);
  }

  @media (max-width: 700px) {
    .product-card__row {
      grid-template-columns: 1fr;
    }
  }

  .product-card__row h3,
  .product-card__row h4 {
    margin: 0;
  }

  .product-card__row p {
    margin: 0;
  }

  .product-card__highlights {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .product-card__highlights li {
    margin-bottom: 0.3rem;
  }

  .product-card .btn {
    justify-self: start;
  }

  .how__slogan {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--size-h2);
    color: var(--heading);
    text-transform: uppercase;
    margin-block: 1.5rem 2.5rem;
  }

  .how-steps {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .how-step {
    display: grid;
    grid-template-columns: 4rem minmax(10rem, 1fr) 2fr minmax(10rem, 16rem);
    gap: 1.5rem;
    align-items: center;
    background: var(--bg);
    border: 1px solid var(--outline-variant);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }

  @media (max-width: 900px) {
    .how-step {
      grid-template-columns: 3rem 1fr;
    }
    .how-step__detail {
      grid-column: 2;
    }
    .how-step img {
