---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TechCard from '../components/TechCard.astro';
---

<Base title="Home | Pluribus Inc">
  <section class="hero section--black">
    <div class="container hero__inner">
      <img
        class="hero__logo"
        src="/images/logo-pluribus.png"
        alt="Pluribus"
        width="840"
        height="212"
        fetchpriority="high"
      />
      <h1>Providing a personalized, safer world for each person!</h1>
      <p class="lead">
        Big data, geosocial &amp; geospatial analytics — pioneering Identity-Based Navigation®.
      </p>
      <div class="hero__actions">
        <a class="btn btn--solid" href="/technology/">Explore Our Technology</a>
        <a class="btn btn--ghost" href="/contact/">Get in Touch</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Our Technology" title="What we build" />
      <div class="tech-grid">
        <TechCard number="01" name="Big Data" href="/technology/#big-data">
          Making the complex simple, the obscure plain and the unknown known — insights that help
          you live a better life.
        </TechCard>
        <TechCard number="02" name="IBN®" href="/identity-based-navigation/">
          Identity-Based Navigation® is our specialty: a personalized and optimized world, based on
          who YOU are.
        </TechCard>
        <TechCard number="03" name="OurWays™" href="/technology/#ourways">
          A 21st-century, A.I. &amp; 5G-enabled, geosocial navigation application under development
          by our award-winning team.
        </TechCard>
        <TechCard number="04" name="ANJEL® Tech" href="https://www.anjel.tech" external>
          A cloud-based, GPS-enabled, live-streaming and recording Personal Security Service for you
          and your loved ones.
        </TechCard>
        <TechCard number="05" name="Guardian ANJEL®" href="https://www.guardiananjel.com" external>
          Military installation security with real-time, first-person intelligence. When seconds
          matter, Guardian ANJEL delivers.
        </TechCard>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container mission">
      <div>
        <SectionHeading eyebrow="About Pluribus" title="Our mission" />
        <p class="mission__text">
          We were created to tell every person in the world where they are, based on who they are;
          to help every person in the world make smarter decisions about where they go and how they
          get there, based on who they are; to make the world a safer and better place for each and
          every person, based on who they are; and to lead the world in Identity-Based Navigation®.
        </p>
        <a class="btn btn--ghost" href="/about/">More about us</a>
      </div>
      <div class="mission__vision card">
        <span class="eyebrow">Our Vision</span>
        <p class="mission__vision-text">
          Intelligent, Identity-Based Navigation® for human- and machinekind.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container cta-band card">
      <div>
        <h2>Ready to learn more?</h2>
        <p class="cta-band__text">
          Request more information about Pluribus, our technology, or partnership opportunities.
        </p>
      </div>
      <a class="btn btn--solid" href="/contact/">Contact Us</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(4rem, 10vw, 8rem);
    text-align: center;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__logo {
    width: min(560px, 86vw);
    height: auto;
    margin-bottom: 2.5rem;
  }

  .hero h1 {
    max-width: 22ch;
  }

  .hero .lead {
    margin-inline: auto;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-top: 2rem;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .mission {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (max-width: 820px) {
    .mission {
      grid-template-columns: 1fr;
    }
  }

  .mission__text {
    margin-bottom: 2rem;
  }

  .mission__vision {
    border-left: 4px solid var(--color-accent);
  }

  .mission__vision-text {
    font-size: var(--size-step-1);
    font-weight: 600;
    margin: 0;
  }

  .cta-band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(2rem, 5vw, 3.5rem);
  }

  .cta-band h2 {
    margin-bottom: 0.4rem;
  }

  .cta-band__text {
    color: var(--color-muted);
    margin: 0;
  }
</style>
